# ==============================================================================
# DataCore 環境変数設定テンプレート (env.example)
# 使い方: ./init.sh env  （.env が無い場合のみこのファイルから作成されます）
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. システム基本設定 & 認証 (JWT / ACL)
# ------------------------------------------------------------------------------
APP_NAME=datacore
APP_ENV=development
DEBUG=True
TIMEZONE=Asia/Tokyo
LOG_LEVEL=INFO

# JWT 認証・認可設定
# ★ ./init.sh env 実行時に自動的にランダムな値へ置き換えられます
JWT_SECRET_KEY=change_this_to_a_secure_random_key_for_jwt
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 2. データベース設定 (PostgreSQL 16 + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_change_me
POSTGRES_DB=datacore_db

# SQLAlchemy Async Connection URL (AsyncIO + asyncpg)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:5432/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# 3. 分散タスクキュー & リアルタイム監視設定 (Celery / Flower)
# ------------------------------------------------------------------------------
FLOWER_PORT=5555
CELERY_BROKER_URL=redis://redis:6379/0
REDIS_PORT=6379

# Flower の簡易認証（Basic認証）
# FLOWER_BIND=0.0.0.0 でLAN内に公開する場合は必ず変更すること
FLOWER_AUTH_USER=flower
FLOWER_AUTH_PASS=change_this_flower_password

# ------------------------------------------------------------------------------
# 4. API & フロントエンドサービス設定
# ------------------------------------------------------------------------------
WEB_PORT=8000
METABASE_PORT=3001
WEBUI_PORT=3000

# 各サービスをどこに公開するか（ホスト側のバインドアドレス）
#   127.0.0.1 = ローカル限定（既定・安全）
#   0.0.0.0   = LAN内の別端末（スマホなど）からアクセス可能にする
#   WebUI(3000) は常に公開。fastapi/flower/metabase/postgres を対象。
#   例: スマホからFlowerとMetabaseを見たい場合
#     FLOWER_BIND=0.0.0.0
#     METABASE_BIND=0.0.0.0
API_BIND=127.0.0.1
FLOWER_BIND=127.0.0.1
METABASE_BIND=127.0.0.1
DB_BIND=127.0.0.1

# Metabase Signed JWT 埋め込み設定
METABASE_SECRET_KEY=change_this_to_metabase_embedding_secret_key
METABASE_SITE_URL=http://localhost:3001
# ブラウザからMetabaseを開くURL（別端末から使う場合は到達可能なホスト名/IPに変更）
METABASE_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 5. LLM / OCR / Embedding / 外部 API 設定
# ------------------------------------------------------------------------------
# Linux Docker bridge の既定例。環境に応じて到達可能な Ollama URL に変更してください。
OLLAMA_BASE_URL=http://172.17.0.1:11434
TEXT_EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=llama3.2:1b
CLIP_MODEL_NAME=rinna/japanese-clip-vit-b-16

# オプション / 将来用 外部 API Key
OPENAI_API_KEY=your-openai-api-key-here

# ------------------------------------------------------------------------------
# 6. ストレージ & パス設定
# ------------------------------------------------------------------------------
STORAGE_DIR=/app/data/storage
L1_RAW_STORAGE_PATH=/app/data/storage/l1_raw

# ------------------------------------------------------------------------------
# 7. L3 アドオン設定
# ------------------------------------------------------------------------------
# カンマ区切りで指定 (例: receipt,finunce_parser)
# ./init.sh env で対話的に設定できます
ENABLED_L3_ADDONS=
